{
  "$schema_version": "1.0.0",
  "asset_name": "lexical-tables",
  "description": "Consolidated deterministic lexical-substitution layer migrated from arabic-ai-text-humanizer references/13-inherited-lexical-tables.md. Five base tables (v1 substrate) + three corpus-mined extensions (Gap A/B/D from references/12-corpus-findings.md). Each sub-table declares its own substitution policy so consumers can apply identical semantics without re-reading the original Python.",
  "provenance": {
    "source_repo": "arabic-ai-text-humanizer",
    "source_file": "references/13-inherited-lexical-tables.md",
    "source_release": "v2.7.0",
    "v1_substrate_origin": "predecessor lexical-only Arabic humanizer (referenced as 'v1' in source)",
    "extensions_origin": "corpus mining documented in references/12-corpus-findings.md (Gaps A, B, D)"
  },
  "tables": {
    "ai_phrases": {
      "policy": "deterministic_all_matches",
      "policy_notes": "Every match is rewritten; one alternative chosen at runtime. v1 default. v2 allows --intensity < 1.0 to skip a fraction probabilistically.",
      "entries": [
        {"input": "من المهم ملاحظة", "alternatives": ["للعلم", "من الجدير بالذكر", "تذكر"]},
        {"input": "من الجدير بالذكر", "alternatives": ["للعلم", "من المهم ملاحظة", "تذكر"]},
        {"input": "من المفيد الإشارة", "alternatives": ["من الجدير بالذكر", "من المهم ملاحظة"]},
        {"input": "في سياق متصل", "alternatives": ["أيضا", "كذلك", "بالإضافة إلى ذلك"]},
        {"input": "في نفس السياق", "alternatives": ["أيضا", "كذلك", "علاوة على ذلك"]},
        {"input": "علاوة على ذلك", "alternatives": ["بالإضافة", "أيضا", "فضلا عن ذلك"]},
        {"input": "بالإضافة إلى ذلك", "alternatives": ["أيضا", "كذلك", "علاوة على ذلك"]},
        {"input": "من ناحية أخرى", "alternatives": ["لكن", "بالمقابل", "في المقابل"]},
        {"input": "على الجانب الآخر", "alternatives": ["بالمقابل", "في المقابل", "لكن"]},
        {"input": "في النهاية", "alternatives": ["أخيرا", "ختاما", "في الختام"]},
        {"input": "في الختام", "alternatives": ["أخيرا", "ختاما", "في النهاية"]},
        {"input": "في البداية", "alternatives": ["أولا", "في الأول", "لنبدأ بـ"]},
        {"input": "كما ذكر سابقا", "alternatives": ["كما قلنا", "كما أسلفنا", "كما سبق"]},
        {"input": "كما أسلفنا", "alternatives": ["كما ذكرنا", "كما سبق", "كما قلنا"]},
        {"input": "من الواضح أن", "alternatives": ["بوضوح", "واضحا", "من البديهي أن"]},
        {"input": "من المهم التأكيد", "alternatives": ["نؤكد", "يجب التنويه", "من الجدير التنويه"]},
        {"input": "لا بد من الإشارة", "alternatives": ["من الجدير بالذكر", "من المهم ملاحظة"]},
        {"input": "في إطار", "alternatives": ["ضمن", "في نطاق", "في مجال"]},
        {"input": "على صعيد", "alternatives": ["في مجال", "فيما يتعلق بـ", "بخصوص"]},
        {"input": "في ظل", "alternatives": ["مع", "في حال", "في وقت"]},
        {"input": "بناء على ما تقدم", "alternatives": ["وبناء عليه", "لذلك", "وعليه"]},
        {"input": "في ظل التطورات", "alternatives": ["مع التطورات", "بالنظر إلى التطورات"]},
        {"input": "جدير بالذكر", "alternatives": ["من المهم", "من الجدير بالذكر", "للعلم"]},
        {"input": "من الممكن أن", "alternatives": ["قد", "يمكن أن", "ربما"]},
        {"input": "من المتوقع أن", "alternatives": ["من المرجح", "من المنتظر", "يتوقع"]},
        {"input": "يشار إلى أن", "alternatives": ["للعلم", "من الجدير بالذكر"]},
        {"input": "يعتبر من", "alternatives": ["هو من", "يعد من"]},
        {"input": "في هذا الإطار", "alternatives": ["في هذا السياق", "ضمن هذا", "في هذا المجال"]},
        {"input": "على المستوى", "alternatives": ["في مجال", "فيما يخص"]},
        {"input": "في مجال", "alternatives": ["بخصوص", "فيما يتعلق بـ"]},
        {"input": "تجدر الإشارة إلى أن", "alternatives": ["يذكر أن", "والحقيقة أن"], "source_tag": "gap_a"},
        {"input": "في هذا الصدد", "alternatives": ["هنا", "بصدد ذلك"], "source_tag": "gap_a"},
        {"input": "من هذا المنطلق", "alternatives": ["من هنا", "لذلك"], "source_tag": "gap_a"},
        {"input": "على هذا الأساس", "alternatives": ["بناء على ذلك", "لذلك"], "source_tag": "gap_a"},
        {"input": "لا شك أن", "alternatives": ["بلا شك"], "source_tag": "gap_a"},
        {"input": "من المعروف أن", "alternatives": ["المعروف أن"], "source_tag": "gap_a"},
        {"input": "كما هو معلوم", "alternatives": ["المعلوم أن"], "source_tag": "gap_a"},
        {"input": "في حقيقة الأمر", "alternatives": ["في الحقيقة"], "source_tag": "gap_a"},
        {"input": "لا يخفى على أحد", "alternatives": ["الواضح أن"], "source_tag": "gap_a"},
        {"input": "تجدر الإشارة كذلك", "alternatives": ["كذلك", "يضاف"], "source_tag": "gap_a"}
      ]
    },
    "connectors": {
      "policy": "probabilistic_per_match",
      "probability": 0.7,
      "policy_notes": "Each match is replaced with probability 0.7. The remaining 0.3 are left as-is to retain variation rather than uniform stripping.",
      "entries": [
        {"input": "وعلاوة على ذلك،", "replacement": "كما أن،"},
        {"input": "ومع ذلك،", "replacement": "لكن،"},
        {"input": "وبالتالي،", "replacement": "لذلك،"},
        {"input": "وبناء عليه،", "replacement": "لذلك،"},
        {"input": "على سبيل المثال،", "replacement": "مثلا،"},
        {"input": "في المقابل،", "replacement": "بالمقابل،"},
        {"input": "على العكس من ذلك،", "replacement": "بعكس ذلك،"},
        {"input": "باختصار،", "replacement": "بشكل مختصر،"},
        {"input": "فضلا عن ذلك،", "replacement": "كذلك،", "source_tag": "gap_b"},
        {"input": "إضافة إلى ذلك،", "replacement": "كذلك،", "source_tag": "gap_b"},
        {"input": "من جهة أخرى،", "replacement": "بالمقابل،", "source_tag": "gap_b"},
        {"input": "من جانب آخر،", "replacement": "بالمقابل،", "source_tag": "gap_b"},
        {"input": "بصورة عامة،", "replacement": "عموما،", "source_tag": "gap_b"},
        {"input": "بشكل عام،", "replacement": "عموما،", "source_tag": "gap_b"},
        {"input": "بشكل خاص،", "replacement": "خصوصا،", "source_tag": "gap_b"},
        {"input": "في الواقع،", "replacement": "فعلا،", "source_tag": "gap_b"},
        {"input": "في حين أن", "replacement": "بينما", "source_tag": "gap_b"},
        {"input": "على الرغم من ذلك،", "replacement": "رغم ذلك،", "source_tag": "gap_b"},
        {"input": "نتيجة لذلك،", "replacement": "لذلك،", "source_tag": "gap_b"},
        {"input": "استنادا إلى ذلك،", "replacement": "بناء عليه،", "source_tag": "gap_b"},
        {"input": "تبعا لذلك،", "replacement": "لذلك،", "source_tag": "gap_b"}
      ]
    },
    "repetitive_starters": {
      "policy": "consecutive_repeat_trigger",
      "probability": 0.5,
      "policy_notes": "When the same starter recurs across consecutive sentences, replace with one of the pronoun-prefixed alternatives with 50% probability per repeat.",
      "detectors": ["تعتبر", "يعتبر", "تعد", "يعد", "يمكن", "تستطيع", "نستطيع"],
      "replacements": ["فهي", "وهي", "إنها", "كما أنها"]
    },
    "fillers": {
      "policy": "intensity_gated",
      "probability_formula": "intensity * 0.1",
      "min_sentence_chars": 40,
      "skip_first_sentence": true,
      "policy_notes": "Active only when --intensity > 0.4. Prepend a 'human filler' to a sentence with probability ≈ intensity × 0.1, only on sentences > 40 chars, never the first sentence.",
      "entries": ["طبعا،", "بالمناسبة،", "في الحقيقة،", "أعني،"]
    },
    "numbered_transitions": {
      "policy": "probabilistic_per_match",
      "probability": 0.5,
      "policy_notes": "Rewrite positional adverbs with 50% probability to introduce variance.",
      "entries": [
        {"input": "أولا،", "replacement": "في البداية،"},
        {"input": "ثانيا،", "replacement": "بعد ذلك،"},
        {"input": "ثالثا،", "replacement": "أيضا،"},
        {"input": "رابعا،", "replacement": "علاوة على ذلك،"},
        {"input": "أخيرا،", "replacement": "في النهاية،"}
      ]
    },
    "quote_verbs": {
      "policy": "rotation_pool",
      "policy_notes": "News-register only. AI defaults to قال/يقول; rotate from the pool to mimic the natural rotation observed in the news corpus. Rotation is positional (cycle through pool) or random per consumer choice.",
      "register_filter": "news",
      "entries": [
        {"input": "قال", "rotation_pool": ["أكد", "أشار", "أوضح", "أضاف", "صرح", "ذكر", "نوه", "لفت"], "source_tag": "gap_d"},
        {"input": "يقول", "rotation_pool": ["يرى", "يعتقد", "يزعم", "يقرر", "يؤكد"], "source_tag": "gap_d"},
        {"input": "ذكر أن", "rotation_pool": ["أفاد بأن", "أشار إلى أن", "لفت إلى أن", "كشف أن"], "source_tag": "gap_d"}
      ]
    },
    "templated_starters": {
      "policy": "advisory_strategy",
      "policy_notes": "Gap C from corpus mining. Each entry describes a STRATEGY for rephrasing a templated AI opener; not a mechanical substitution. Consumers may implement via LLM rewriting or skip. The asset documents the pattern; it does NOT promise deterministic application.",
      "entries": [
        {"pattern": "يلعب X دورا", "strategy": "dive directly into the role: 'X يحدد / يشكل / يصنع'", "source_tag": "gap_c"},
        {"pattern": "يشكل X عاملا", "strategy": "replace with active claim: 'X هو السبب الرئيسي'", "source_tag": "gap_c"},
        {"pattern": "يمثل X جزءا", "strategy": "'X هو' / 'X يعد'", "source_tag": "gap_c"},
        {"pattern": "يكمن X في", "strategy": "'السبب: ...' / 'ها هو السبب:'", "source_tag": "gap_c"},
        {"pattern": "تنبع X من", "strategy": "'يأتي من' / 'أصلها'", "source_tag": "gap_c"},
        {"pattern": "تتمثل X في", "strategy": "'هي:' / 'تتلخص في'", "source_tag": "gap_c"},
        {"pattern": "تكتسب X أهمية", "strategy": "'تهم' / 'حاسمة'", "source_tag": "gap_c"},
        {"pattern": "تواجه X تحديات", "strategy": "'أمام X تحديات' / 'X يتعثر في'", "source_tag": "gap_c"},
        {"pattern": "تشهد X تطورا", "strategy": "'X يتطور'", "source_tag": "gap_c"},
        {"pattern": "تسعى X إلى", "strategy": "'X تريد' / 'X تطمح إلى'", "source_tag": "gap_c"}
      ]
    }
  },
  "global_policies": {
    "quoted_span_bypass": {
      "description": "Substitution should be suppressed inside quoted spans (\"...\" and «...»). Source: Gap F in references/13-inherited-lexical-tables.md.",
      "applies_to": ["ai_phrases", "connectors", "numbered_transitions"]
    },
    "intensifier_destacking": {
      "description": "Detect and collapse stacked intensifiers (e.g., 'في غاية الأهمية البالغة جدا'). Humans rarely stack; AI does. Source: Gap G.",
      "applies_to": ["all"],
      "examples": [
        "في غاية الأهمية البالغة جدا → في غاية الأهمية",
        "بشكل كبير جدا → بشكل كبير",
        "بصورة ملحوظة وواضحة → بصورة ملحوظة"
      ]
    },
    "register_gating": {
      "description": "Substitutions should be gated by detected register. Source: Gap E.",
      "rules": {
        "classical": "suppress vernacular fillers (طبعا، يعني)",
        "news": "allow news-style transitions; suppress poetic devices",
        "technical": "prefer simpler alternatives in every substitution table"
      }
    }
  }
}
